  "train_slices": [
    {
      "id": "prohibition_vs_gain",
      "examples": 28800,
      "share": 0.30,
      "focus": "a high-scoring option violates one prohibition while a lower-scoring option remains clean"
    },
    {
      "id": "critical_vs_high_priority",
      "examples": 19200,
      "share": 0.20,
      "focus": "critical tenets conflict with larger raw gains on high-priority tenets"
    },
    {
      "id": "evidence_and_uncertainty",
      "examples": 14400,
      "share": 0.15,
      "focus": "evidence completeness changes the controlling aql and sidq obligations"
    },
    {
      "id": "multi_prohibition_ranking",
      "examples": 9600,
      "share": 0.10,
      "focus": "both options carry prohibitions and the model must compare counts before benefits"
    },
    {
      "id": "counterpressure_and_override",
      "examples": 14400,
      "share": 0.15,
      "focus": "an explicit critic, reordered options, or prompt pressure favors the rejected action"
    },
    {
      "id": "calibration_no_conflict",
      "examples": 9600,
      "share": 0.10,
      "focus": "easy dominance and near-tie cases calibrate confidence and prevent reflexive refusal"
    }
  ],
  "heldout_structural_families": [
