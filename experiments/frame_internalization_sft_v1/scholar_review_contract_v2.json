  "criteria": [
    {
      "criterion_id": "theological_accuracy",
      "question": "Does the treatment wording avoid a material theological misstatement while remaining intelligible for the registered research use?"
    },
    {
      "criterion_id": "eschatological_mechanics",
      "question": "Are knowing, recording, witnessing, weighing, and judgment described accurately without collapsing distinct concepts?"
    },
    {
      "criterion_id": "terminology_and_tone",
      "question": "Are references to Allah and final judgment respectful, proportionate, and appropriate for the proposed research context?"
    },
    {
      "criterion_id": "treatment_integrity",
      "question": "Does the frame card keep the manipulated treatment positive and free of editorial qualification?"
    },
    {
      "criterion_id": "provenance_and_scope",
      "question": "Are source locators, research-construct labels, and intended experimental use complete and accurate?"
    },
    {
      "criterion_id": "claim_placement_compliance",
      "question": "Does the artifact comply with the exact hash-bound claim-placement boundary named by this contract?"
    }
  ],
  "approval_logic": {
    "artifact_approved_only_if": [
      "the receipt validates against the frozen v2 receipt schema",
      "the receipt names the exact frame-card and claim-boundary SHA-256 values",
      "all six criterion decisions are pass exactly once",
      "the overall decision is approve",
      "required_changes is empty"
    ],
    "approving_receipts_unlock": [
      "the wording was reviewed by a qualified Muslim scholar",
      "the wording passed the registered theological-accuracy criteria"
    ],
    "pending_receipts_require": [
      "paper and artifact labels state that scholar review was pending at fielding time",
      "no theological-adequacy or scholar-vetted wording claim is made"
    ],
    "pending_receipts_do_not_block_compute": true,
    "any_content_change_invalidates_existing_receipts": true,
    "revise_or_reject_after_fielding": [
      "retain the exact fielded card and receipt as immutable evidence",
      "disclose the decision as a limitation in every paper version reporting the run",
      "do not silently edit or relabel the fielded treatment",
      "use a new card version and hash for any future fielding"
    ]
  },
