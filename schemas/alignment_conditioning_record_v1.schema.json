{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alignment_conditioning_record_v1",
  "title": "Alignment Conditioning Record V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_version",
    "example_id",
    "split",
    "constitution",
    "prompt",
    "options",
    "behavioral_reference",
    "criticality",
    "reasoning_provenance",
    "deduplication",
    "provenance",
    "token_counts"
  ],
  "properties": {
    "record_version": {"const": "alignment_conditioning_record_v1"},
    "example_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test"]},
    "constitution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constitution_id", "version", "sha256", "needs_scholar_review"],
      "properties": {
        "constitution_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "needs_scholar_review": {"type": "boolean"}
      }
    },
    "prompt": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["system", "user"]},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["option_id", "option_text"]
      }
    },
    "behavioral_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "decision_text",
        "public_reflection",
        "relevant_tenet_ids",
        "tenet_label_method",
        "is_constitutional_approval"
      ],
      "properties": {
        "decision_id": {"type": "string", "minLength": 1},
        "decision_text": {"type": "string", "minLength": 1},
        "public_reflection": {"type": "string", "minLength": 1},
        "relevant_tenet_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "tenet_label_method": {"type": "string", "minLength": 1},
        "is_constitutional_approval": {"const": false}
      }
    },
    "criticality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "threshold", "basis", "is_proxy_label"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "is_proxy_label": {"const": true}
      }
    },
    "reasoning_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_reflection_included", "hidden_reasoning_present_at_source", "hidden_reasoning_included", "reasoning_marker_present_at_source"],
      "properties": {
        "public_reflection_included": {"const": true},
        "hidden_reasoning_present_at_source": {"type": "boolean"},
        "hidden_reasoning_included": {"const": false},
        "reasoning_marker_present_at_source": {"type": "boolean"}
      }
    },
    "deduplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["near_duplicate_cluster_id", "scenario_sha256"],
      "properties": {
        "near_duplicate_cluster_id": {"type": "string", "pattern": "^[a-f0-9]{20}$"},
        "scenario_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_path", "source_format", "source_license_status", "source_constitution_id", "source_model_id", "source_prompt_id", "source_encounter_id"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_path": {"type": "string", "minLength": 1},
        "source_format": {"type": "string", "minLength": 1},
        "source_license_status": {"type": "string", "minLength": 1},
        "source_constitution_id": {"type": "string"},
        "source_model_id": {"type": "string"},
        "source_prompt_id": {"type": "string"},
        "source_encounter_id": {"type": "string"},
        "playthrough_index": {"type": ["integer", "null"], "minimum": 0},
        "step_index": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "token_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "prompt", "behavioral_completion", "behavioral_conditioning_prompt", "rl_prompt", "total", "source_reported"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "prompt": {"type": "integer", "minimum": 0},
        "behavioral_completion": {"type": "integer", "minimum": 0},
        "behavioral_conditioning_prompt": {"type": "integer", "minimum": 0},
        "rl_prompt": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 0},
        "source_reported": {"type": "integer", "minimum": 0}
      }
    }
  }
}
