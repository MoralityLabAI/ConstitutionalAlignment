{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moralitylab.ai/schemas/frame_internalization_frame_card_v1.schema.json",
  "title": "Frame internalization frame card v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "version",
    "label",
    "construct",
    "prompt_text",
    "mechanics",
    "source_refs",
    "status",
    "use_constraints",
    "claim_boundaries",
    "tokenization"
  ],
  "properties": {
    "schema_version": {
      "const": "frame_internalization_frame_card.v1"
    },
    "frame_id": {
      "type": "string",
      "pattern": "^F3(?:_concrete)?$"
    },
    "version": {
      "const": "1.0.0"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "construct": {
      "type": "string",
      "minLength": 1
    },
    "prompt_text": {
      "type": "string",
      "minLength": 100
    },
    "mechanics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "locator", "status"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "recovered_experimental_wording",
              "research_construct_not_scripture",
              "source_citations_pending_scholar_review"
            ]
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_frozen",
        "frozen_at",
        "needs_scholar_review",
        "approval_state"
      ],
      "properties": {
        "content_frozen": {"const": true},
        "frozen_at": {"const": "2026-07-17"},
        "needs_scholar_review": {"const": true},
        "approval_state": {"const": "pending_external_hash_bound_receipt"}
      }
    },
    "use_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "claim_boundaries": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "tokenization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_tokenizer", "recorded_tokens", "pair_max_spread"],
      "properties": {
        "reference_tokenizer": {"const": "cl100k_base"},
        "recorded_tokens": {"type": "integer", "minimum": 1},
        "pair_max_spread": {"const": 0.1}
      }
    }
  }
}
