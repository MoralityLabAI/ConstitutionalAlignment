{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moralitylab.ai/schemas/frame_internalization_frame_card_v2.schema.json",
  "title": "Frame internalization frame card v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "version",
    "label",
    "construct",
    "prompt_text",
    "mechanics",
    "source_refs",
    "status",
    "use_constraints",
    "claim_boundary_ref",
    "tokenization"
  ],
  "properties": {
    "schema_version": {"const": "frame_internalization_frame_card.v2"},
    "frame_id": {"type": "string", "pattern": "^F3(?:_concrete)?$"},
    "version": {"const": "2.0.0"},
    "label": {"type": "string", "minLength": 1},
    "construct": {"type": "string", "minLength": 1},
    "prompt_text": {"type": "string", "minLength": 100},
    "mechanics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "locator", "status"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "recovered_experimental_wording",
              "research_construct_not_scripture",
              "source_citations_pending_review"
            ]
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_frozen",
        "frozen_at",
        "compute_use_state",
        "scholar_review_state"
      ],
      "properties": {
        "content_frozen": {"const": true},
        "frozen_at": {"const": "2026-07-17"},
        "compute_use_state": {"const": "governed_by_protocol_amendment_v2"},
        "scholar_review_state": {"const": "pending_nonblocking_claim_gate"}
      }
    },
    "use_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "forbidden": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "claim_boundary_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "const": "experiments/frame_internalization_sft_v1/frame_cards/claim_boundary_v1.json"
        },
        "sha256": {
          "const": "0941cf1b44669a1547f0572352ada7f97a98b3d729b6e84a867081092a65d5d1"
        }
      }
    },
    "tokenization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_tokenizer", "recorded_tokens", "pair_max_spread"],
      "properties": {
        "reference_tokenizer": {"const": "cl100k_base"},
        "recorded_tokens": {"type": "integer", "minimum": 1},
        "pair_max_spread": {"const": 0.1}
      }
    }
  }
}
