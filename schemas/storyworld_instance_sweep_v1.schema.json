{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moralitylab.ai/schemas/storyworld_instance_sweep_v1.schema.json",
  "title": "Deterministic storyworld instance sweep",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sweep_id", "base_world_paths", "required_factors", "profiles"],
  "properties": {
    "schema_version": {"const": "storyworld_instance_sweep_v1"},
    "sweep_id": {"$ref": "#/$defs/id"},
    "base_world_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_factors": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["resources", "observation", "authority", "timing", "counterpart_behavior"]}
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "description", "factor_values", "overrides"],
        "properties": {
          "profile_id": {"$ref": "#/$defs/id"},
          "description": {"type": "string", "minLength": 1},
          "factor_values": {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "overrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "initial_variables": {"type": "object", "additionalProperties": {"type": "integer"}},
              "agents_by_id": {"type": "object", "additionalProperties": {"type": "object"}},
              "facts_by_id": {"type": "object", "additionalProperties": {"type": "object"}},
              "states_by_id": {"type": "object", "additionalProperties": {"type": "object"}}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,79}$"}
  }
}
